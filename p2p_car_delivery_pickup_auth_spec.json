          "_____________________________",
          "",
          "{{authorization_date}}"
        ],
        [
          "Printed Name",
          "{{owner_name}}",
          "",
          ""
        ],
        [
          "Renter Signature",
          "",
          "_____________________________",
          "{{authorization_date}} (if present)"
        ],
        [
          "Printed Name",
          "",
          "{{renter_name}}",
          ""
        ]
      ],
      "style": "Table Grid"
    }
