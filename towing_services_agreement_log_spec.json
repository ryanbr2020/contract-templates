  "blocks": [
    {
      "type": "heading",
      "text": "TOWING COMPANY SERVICES AGREEMENT AND TOWING LOG",
      "level": 1,
      "style": "CT"
    },
    {
      "type": "paragraph",
      "text": "This Towing Services Agreement is entered into on {{agreement_date}} between {{towing_company_name}} (\"Towing Company\") and {{client_name}} (\"Client\").",
      "style": "BT"
    },
    {
      "type": "heading",
      "text": "SERVICES",
      "level": 2,
      "style": "SH"
    },
    {
      "type": "paragraph",
      "text": "Towing Company agrees to provide the following towing and recovery services to Client:",
      "style": "BT"
    },
    {
      "type": "table",
      "header": [
        "Service Type",
        "Description",
        "Rate / Fee"
      ],
      "rows": [
        [
          "Light-Duty Tow (standard vehicle)",
          "Tow of passenger cars, light trucks, and motorcycles up to {{light_duty_weight}} lbs using a light-duty tow truck.",
          "{{light_duty_rate}} (Flat rate / Per mile: {{light_duty_per_mile}})"
        ],
        [
          "Medium-Duty Tow (box truck, van, RV)",
          "Tow of medium-duty vehicles up to {{medium_duty_weight}} lbs using a medium-duty tow truck.",
          "{{medium_duty_rate}} (Flat rate / Per mile: {{medium_duty_per_mile}})"
        ],
        [
          "Heavy-Duty Tow (semi truck, bus, large equipment)",
          "Tow of heavy-duty vehicles and equipment using a heavy-duty wrecker or rotators.",
          "{{heavy_duty_rate}} (Flat rate / Per mile: {{heavy_duty_per_mile}})"
        ],
        [
          "Flatbed Tow",
          "Tow using a flatbed / roll-back truck \u2014 Vehicle driven onto flatbed.",
          "{{flatbed_rate}} (Flat rate / Per mile: {{flatbed_per_mile}})"
        ],
        [
          "Winching / Recovery",
          "Vehicle winching from ditch, embankment, or other difficult location.",
          "{{winching_rate}} (Flat rate / Per hour: {{winching_per_hour}})"
        ],
        [
          "Lockout / Key Service",
          "Vehicle lockout service \u2014 provide keys or open locked vehicle.",
          "{{lockout_rate}} (Flat rate / Per occurrence)"
        ],
        [
          "Roadside Assistance",
          "Jump start, fuel delivery, tire change, etc. at roadside.",
          "{{roadside_rate}} (Flat rate / Per service type)"
        ],
        [
          "Impound / Storage",
          "Tow and store vehicle at towing company's facility.",
          "{{impound_rate}} (Flat rate for tow + $ {{storage_per_day}} per day for storage)"
        ],
        [
          "Long-Distance Tow",
          "Tow over long distance (beyond {{local_radius}} miles).",
          "{{long_distance_rate}} (Flat rate / Per mile: {{long_distance_per_mile}})"
        ],
        [
          "Other: {{other_service}}",
          "{{other_service_description}}",
          "{{other_service_rate}}"
        ]
      ],
      "style": "Table Grid"
    },
    {
      "type": "heading",
      "text": "CLIENT AND SERVICE DETAILS",
      "level": 2,
      "style": "SH"
    },
    {
      "type": "table",
      "header": [
        "Item",
        "Details"
      ],
      "rows": [
        [
          "Client Name",
          "{{client_name}}"
        ],
        [
          "Client Type",
          "{{client_type}} (Property owner / Law enforcement / Insurance company / Individual / Fleet / Other)"
        ],
        [
          "Client Contact",
          "{{client_contact}} (Name: {{client_contact_name}} \u2014 Phone: {{client_contact_phone}} \u2014 Email: {{client_contact_email}})"
        ],
        [
          "Service Request Method",
          "{{service_request_method}} (Phone / Email / Online dispatch / App / Other)"
        ],
        [
          "Service Area",
          "{{service_area}} (City/County/Region \u2014 Radius: {{service_radius}} miles)"
        ],
        [
          "Response Time Commitment",
          "{{response_time}} (within {{response_time_hours}} hours of request \u2014 24/7 availability / Business hours only / Other)"
        ],
        [
          "After-Hours Emergency Contact",
          "{{emergency_contact}} (Phone: {{emergency_contact_phone}})"
        ]
      ],
      "style": "Table Grid"
    },
    {
      "type": "heading",
      "text": "TOWING COMPANY RESPONSIBILITIES",
      "level": 2,
      "style": "SH"
    },
    {
      "type": "bullet_list",
      "items": [
        "Towing Company will respond to service requests within the agreed response time.",
        "Towing Company will provide licensed, trained, and professional towing operators.",
        "Towing Company will use equipment that is appropriate for the Vehicle and in good working condition.",
        "Towing Company will tow and handle the Vehicle with reasonable care to avoid damage.",
        "Towing Company will transport the Vehicle to {{default_destination}} (Client's designated location / Towing Company's facility / Repair shop of Client's choice / Other).",
        "Towing Company will provide a receipt / invoice for each service upon completion.",
        "Towing Company will store impounded Vehicles in a secure facility.",
        "Towing Company will maintain insurance coverage as stated below.",
        "Towing Company will comply with all applicable laws and regulations.",
        "{{towing_company_extra}}"
      ]
    },
    {
      "type": "heading",
      "text": "CLIENT RESPONSIBILITIES",
      "level": 2,
      "style": "SH"
    },
    {
      "type": "bullet_list",
      "items": [
        "Client must provide accurate information about the Vehicle and the situation when requesting service.",
        "Client must provide access to the Vehicle (keys, unlock, etc.) if needed for towing.",
        "Client is responsible for all fees for services provided, in accordance with the rates stated above.",
        "Client must pay all invoices within {{payment_terms}} (upon receipt / Net-15 / Net-30 / Other).",
        "Client is responsible for providing correct destination for Vehicle transport.",
        "Client is responsible for any damage caused by Client or Client's agents to the Vehicle or to Towing Company's equipment.",
        "Client is responsible for any fines, tickets, or penalties related to the Vehicle.",
        "Client must provide accurate Vehicle identification (make, model, year, VIN, license plate, location).",
        "{{client_towing_extra}}"
      ]
    },
    {
      "type": "heading",
