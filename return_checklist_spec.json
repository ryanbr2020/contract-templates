  "blocks": [
    {
      "type": "heading",
      "text": "VEHICLE RETURN CHECKLIST",
      "level": 1,
      "style": "ContractTitle"
    },
    {
      "type": "paragraph",
      "text": "Complete this checklist at the time of Vehicle return. Both Owner and Renter should review and sign.",
      "style": "BodyText"
    },
    {
      "type": "table",
      "header": [
        "Field",
        "Details"
      ],
      "rows": [
        [
          "Vehicle Make/Model/Year",
          "{{vehicle_make}} {{vehicle_model}} {{vehicle_year}}"
        ],
        [
          "VIN",
          "{{vehicle_vin}}"
        ],
        [
          "License Plate",
          "{{license_plate}}"
        ],
        [
          "Return Date/Time",
          "{{return_date}} at {{return_time}}"
        ],
        [
          "Owner Name",
          "{{owner_name}}"
        ],
        [
          "Renter Name",
          "{{renter_name}}"
        ]
      ],
      "style": "Table Grid"
    },
    {
      "type": "heading",
      "text": "RETURN INSPECTION",
      "level": 2,
      "style": "SectionHeading"
    },
    {
      "type": "table",
      "header": [
        "Check",
        "Item",
        "Status",
        "Notes"
      ],
      "rows": [
