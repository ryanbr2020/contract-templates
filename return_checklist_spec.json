          ""
        ],
        [
          "\u2610",
          "No new exterior damage (compare to trip checklist)",
          "",
          ""
        ],
        [
          "\u2610",
          "No new interior damage or excessive mess",
          "",
          ""
        ],
        [
          "\u2610",
          "All accessories present (floor mats, spare tire, jack, etc.)",
          "",
          ""
        ],
        [
          "\u2610",
          "Vehicle returned at agreed location",
          "{{return_location}}",
          ""
        ],
        [
          "\u2610",
          "Vehicle returned at agreed time (late fee: {{late_return_fee}}/hr if late)",
          "",
          ""
        ],
        [
          "\u2610",
          "Keys returned (if physical key exchange)",
          "",
          ""
        ],
        [
          "\u2610",
          "Lockbox code / access code deactivated (if applicable)",
          "",
          ""
        ],
        [
          "\u2610",
