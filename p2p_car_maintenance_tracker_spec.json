      "text": "P2P CAR RENTAL \u2014 MAINTENANCE DUE TRACKER",
      "level": 1,
      "style": "CT"
    },
    {
      "type": "paragraph",
      "text": "This tracker is used to monitor and schedule maintenance for each Vehicle in the P2P car rental fleet. Update after each rental and maintenance event.",
      "style": "BT"
    },
    {
      "type": "heading",
      "text": "VEHICLE OVERVIEW",
      "level": 2,
      "style": "SH"
    },
    {
      "type": "table",
      "header": [
        "Field",
        "Details"
      ],
      "rows": [
        [
          "Vehicle Make/Model/Year",
          "{{vehicle_make}} {{vehicle_model}} {{vehicle_year}}"
        ],
        [
          "VIN",
          "{{vehicle_vin}}"
        ],
        [
          "License Plate",
          "{{license_plate}}"
        ],
        [
          "Owner Name",
          "{{owner_name}}"
        ],
        [
          "Current Odometer",
          "{{current_odometer}} miles (as of {{odometer_date}})"
        ],
        [
          "Total Miles Driven in Last 30 Days",
          "{{miles_last_30_days}} miles"
        ],
        [
          "Number of Rentals in Last 30 Days",
          "{{rentals_last_30_days}}"
        ],
        [
          "Next Scheduled Maintenance Due At",
          "{{next_maint_due_odometer}} miles or {{next_maint_due_date}}"
