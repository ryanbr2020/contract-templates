  "header": "RIDE-SHARE KEY EXCHANGE AND VEHICLE DELIVERY AUTHORIZATION",
  "footer_page_numbers": true,
  "blocks": [
    {
      "type": "heading",
      "text": "RIDE-SHARE KEY EXCHANGE AND VEHICLE DELIVERY AUTHORIZATION",
      "level": 1,
      "style": "CT"
    },
    {
      "type": "paragraph",
      "text": "This Key Exchange and Delivery Authorization is completed on {{exchange_date}} between {{owner_name}} (\"Owner\") and {{driver_name}} (\"Driver\") for Vehicle: {{vehicle_make}} {{vehicle_model}} {{vehicle_year}}, VIN: {{vehicle_vin}}, License Plate: {{license_plate}}.",
      "style": "BT"
    },
    {
      "type": "paragraph",
      "text": "This Authorization documents the physical transfer of the Vehicle and keys from Owner to Driver for use in ride-share operations under the Ride-Share Driver Agreement dated {{agreement_date}}.",
      "style": "BT"
    },
    {
      "type": "heading",
      "text": "VEHICLE AND KEY INFORMATION",
      "level": 2,
      "style": "SH"
    },
    {
      "type": "table",
      "header": [
        "Field",
        "Details"
      ],
      "rows": [
        [
          "Vehicle Make/Model/Year",
          "{{vehicle_make}} {{vehicle_model}} {{vehicle_year}}"
        ],
        [
          "VIN",
          "{{vehicle_vin}}"
        ],
        [
          "License Plate",
          "{{license_plate}}"
        ],
        [
          "Vehicle Color",
          "{{vehicle_color}}"
        ],
        [
          "Number of Keys / Fobs Provided",
          "{{key_count}}"
        ],
        [
          "Key / Fob Type(s)",
          "{{key_type}} (Traditional / Smart key / Key fob / Remote key)"
        ],
        [
          "Key / Fob Serial or ID Numbers",
          "{{key_serial_numbers}}"
        ],
        [
          "Key Handoff Location",
          "{{key_handoff_location}}"
        ],
        [
          "Key Handoff Date and Time",
          "{{key_handoff_date}} at {{key_handoff_time}}"
        ]
      ],
      "style": "Table Grid"
    },
    {
      "type": "heading",
      "text": "VERIFICATION OF VEHICLE CONDITION AT HANDOFF",
      "level": 2,
      "style": "SH"
    },
    {
      "type": "paragraph",
      "text": "Owner and Driver jointly inspect the Vehicle and verify its condition at the time of handoff. Any existing damage, defects, or issues are noted below.",
      "style": "BT"
    },
    {
      "type": "table",
      "header": [
        "#",
        "Inspection Item",
        "Condition",
        "Notes / Observations"
      ],
      "rows": [
        [
          "1",
