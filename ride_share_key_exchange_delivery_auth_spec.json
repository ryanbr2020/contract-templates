    {
      "type": "heading",
      "text": "KEYS ACKNOWLEDGMENT",
      "level": 2,
      "style": "SH"
    },
    {
      "type": "paragraph",
      "text": "Owner provides the following keys/fobs to Driver:",
      "style": "BT"
    },
    {
      "type": "table",
      "header": [
        "Key / Fob #",
        "Description",
        "Condition",
        "Handed to Driver? (Y/N)",
        "Driver Acknowledgment (initials)",
        "Time"
      ],
      "rows": [
        [
          "1",
          "{{key1_desc}}",
          "{{key1_condition}}",
          "{{key1_handed}}",
          "{{key1_driver_init}}",
          "{{key1_time}}"
        ],
        [
          "2",
          "{{key2_desc}}",
          "{{key2_condition}}",
          "{{key2_handed}}",
          "{{key2_driver_init}}",
          "{{key2_time}}"
        ],
        [
          "3",
          "{{key3_desc}}",
          "{{key3_condition}}",
          "{{key3_handed}}",
          "{{key3_driver_init}}",
          "{{key3_time}}"
        ]
      ],
      "style": "Table Grid"
    },
    {
      "type": "paragraph",
      "text": "Driver acknowledges receipt of all keys/fobs and agrees to:",
      "style": "BT"
    },
    {
      "type": "bullet_list",
      "items": [
        "Maintain keys/fobs in safe condition and not lose them.",
        "Not duplicate keys/fobs without Owner's written consent.",
        "Not allow any unauthorized person to possess or use the keys/fobs.",
        "Return all keys/fobs to Owner at the end of the agreement or upon demand.",
        "Report any lost, stolen, or damaged keys/fobs to Owner immediately.",
        "Pay for replacement or reprogramming of lost/stolen keys/fobs as specified in the Driver Agreement.",
        "{{key_ack_extra}}"
      ]
    },
    {
      "type": "heading",
      "text": "OWNER AND DRIVER ACKNOWLEDGMENT",
      "level": 2,
      "style": "SH"
    },
    {
      "type": "paragraph",
      "text": "Both parties acknowledge that the Vehicle and keys have been transferred as described above, that the Vehicle condition has been inspected and any existing damage has been noted, and that Driver accepts responsibility for the Vehicle from the time of handoff in accordance with the Ride-Share Driver Agreement.",
      "style": "BT"
    },
