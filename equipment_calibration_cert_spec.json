          "Signature",
          "_____________________________",
          "_____________________________"
        ],
        [
          "Printed Name",
          "{{renter_name}}",
          "{{owner_name}}"
        ],
        [
          "Date",
          "{{renter_date}}",
          "{{owner_date}}"
        ]
      ],
      "style": "Table Grid"
    }
  ]
