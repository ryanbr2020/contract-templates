    {
      "type": "heading",
      "text": "NOTICE OF CANCELLATION",
      "level": 2,
      "style": "SH"
    },
    {
      "type": "paragraph",
      "text": "In accordance with the policy terms, the insurer will provide the Certificate Holder with at least {{cancellation_notice_period}} days' written notice of cancellation, non-renewal, or material change to the policies listed above (or {{cancellation_notice_period_short}} days for non-payment of premium, if required by state law).",
      "style": "BT"
    },
    {
      "type": "paragraph",
      "text": "Notice of cancellation will be sent to: {{cancellation_notice_address}}.",
      "style": "BT"
    },
    {
      "type": "paragraph",
      "text": "The Insured certifies that the information provided above is true and correct to the best of the Insured's knowledge as of {{certificate_date}}.",
      "style": "BT"
    },
    {
      "type": "heading",
      "text": "SIGNATURES",
      "level": 2,
      "style": "SH"
    },
    {
      "type": "table",
      "header": [
