      "type": "paragraph",
      "text": "This Vehicle Inspection Report is completed by {{inspector_name}} (\"Inspector\") on {{inspection_date}} for Vehicle: {{vehicle_make}} {{vehicle_model}} {{vehicle_year}}, VIN: {{vehicle_vin}}, License Plate: {{license_plate}}.",
      "style": "BT"
    },
    {
      "type": "paragraph",
      "text": "Inspection is conducted for {{platform_name}} (the \"Platform\") in accordance with the Ride-Share Driver Agreement dated {{agreement_date}} between {{platform_name}} and {{driver_name}}.",
      "style": "BT"
    },
