    {
      "type": "heading",
      "text": "RV / CAMPER VEHICLE RENTAL AGREEMENT",
      "level": 1,
      "style": "CT"
    },
    {
      "type": "paragraph",
      "text": "This RV Rental Agreement is entered into on {{agreement_date}} between {{owner_name}} (\"Owner\") and {{renter_name}} (\"Renter\"). Owner agrees to rent to Renter, and Renter agrees to rent from Owner, the following recreational vehicle:",
      "style": "BT"
    },
    {
      "type": "table",
      "header": [
        "Field",
        "Details"
      ],
      "rows": [
        [
          "Vehicle Make/Model/Year",
          "{{vehicle_make}} {{vehicle_model}} {{vehicle_year}}"
        ],
        [
          "VIN",
          "{{vehicle_vin}}"
        ],
        [
          "License Plate / Registration",
          "{{license_plate}} \u2014 State: {{registration_state}}"
        ],
        [
          "Vehicle Type",
          "{{vehicle_type}} (Class A Motorhome / Class B Camper Van / Class C Mini Motorhome / Travel Trailer / Fifth Wheel / Pop-up Camper / Other)"
        ],
        [
