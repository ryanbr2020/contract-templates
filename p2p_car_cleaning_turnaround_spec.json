      "level": 1,
      "style": "CT"
    },
    {
      "type": "paragraph",
      "text": "This checklist is used by the Owner or cleaning crew to ensure the Vehicle is cleaned and ready for the next rental after each trip. Complete this checklist after each rental.",
      "style": "BT"
    },
