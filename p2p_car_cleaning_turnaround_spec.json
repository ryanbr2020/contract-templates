      "type": "table",
      "header": [
        "Field",
        "Details"
      ],
      "rows": [
        [
          "Vehicle Make/Model/Year",
          "{{vehicle_make}} {{vehicle_model}} {{vehicle_year}}"
        ],
        [
          "VIN",
          "{{vehicle_vin}}"
        ],
        [
          "License Plate",
          "{{license_plate}}"
        ],
        [
          "Previous Trip End Date/Time",
          "{{trip_end_date}} at {{trip_end_time}}"
        ],
        [
