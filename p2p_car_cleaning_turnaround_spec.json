        ],
        [
          "Cleaning Start Time",
          "{{cleaning_start_time}}"
        ],
        [
          "Cleaning Completed Time",
          "{{cleaning_completed_time}}"
        ],
        [
          "Cleaner Name",
          "{{cleaner_name}}"
