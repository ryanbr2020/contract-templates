      "style": "Table Grid"
    },
    {
      "type": "heading",
      "text": "SIGNATURE OF DELIVERING / RECEIVING PARTY",
      "level": 2,
      "style": "SH"
    },
    {
      "type": "paragraph",
      "text": "By signing below, the delivering party certifies that the Equipment has been delivered in the condition described above. The receiving party certifies that the Equipment has been received in the condition described above.",
      "style": "BT"
    },
    {
      "type": "table",
      "header": [
        "Party",
        "Signature",
        "Date",
        "Time"
