  "header": "EQUIPMENT DELIVERY / PICKUP LOG",
  "footer_page_numbers": true,
  "blocks": [
    {
      "type": "heading",
      "text": "EQUIPMENT DELIVERY / PICKUP LOG",
      "level": 1,
      "style": "CT"
    },
    {
      "type": "paragraph",
      "text": "This log records the chain of custody for Equipment being delivered to or picked up from the Renter.",
      "style": "BT"
    },
    {
      "type": "heading",
      "text": "DELIVERY / PICKUP INFORMATION",
      "level": 2,
      "style": "SH"
    },
    {
      "type": "table",
      "header": [
        "Field",
        "Details"
      ],
      "rows": [
        [
          "Log Entry #",
          "{{log_entry_number}}"
        ],
        [
          "Date",
          "{{log_date}}"
        ],
        [
          "Time",
          "{{log_time}}"
        ],
        [
          "Log Type",
          "{{log_type}} (Delivery to Renter / Pickup from Renter / Return to Owner / Other)"
        ],
        [
          "Equipment Type / Model",
          "{{equipment_type}} \u2014 {{equipment_model}}"
        ],
        [
          "Serial Number",
          "{{equipment_serial}}"
        ],
        [
          "Equipment ID / Asset Tag",
          "{{equipment_asset_tag}}"
        ],
        [
          "Rental Agreement Reference",
          "{{rental_agreement_ref}}"
        ],
        [
          "Renter Name",
          "{{renter_name}}"
        ],
        [
          "Renter Contact",
          "{{renter_contact}}"
        ],
        [
          "Delivered/Received By",
          "{{delivered_by}}"
        ],
        [
          "Received/Returned By",
          "{{received_by}}"
        ]
      ],
      "style": "Table Grid"
    },
    {
      "type": "heading",
      "text": "CHAIN OF CUSTODY",
      "level": 2,
      "style": "SH"
    },
    {
      "type": "table",
      "header": [
        "Event",
        "Date",
        "Time",
        "From",
        "To",
        "Notes"
      ],
      "rows": [
        [
          "{{custody_event_1}}",
          "{{custody_event_1_date}}",
          "{{custody_event_1_time}}",
          "{{custody_event_1_from}}",
          "{{custody_event_1_to}}",
          "{{custody_event_1_notes}}"
        ],
        [
          "{{custody_event_2}}",
          "{{custody_event_2_date}}",
          "{{custody_event_2_time}}",
          "{{custody_event_2_from}}",
          "{{custody_event_2_to}}",
          "{{custody_event_2_notes}}"
        ],
        [
          "{{custody_event_3}}",
          "{{custody_event_3_date}}",
          "{{custody_event_3_time}}",
          "{{custody_event_3_from}}",
          "{{custody_event_3_to}}",
          "{{custody_event_3_notes}}"
        ]
      ],
      "style": "Table Grid"
    },
    {
      "type": "heading",
      "text": "CONDITION AT DELIVERY / PICKUP",
      "level": 2,
      "style": "SH"
    },
    {
      "type": "table",
      "header": [
        "Inspection Item",
        "Pass",
        "Fail",
        "N/A",
        "Notes"
