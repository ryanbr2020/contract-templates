          "No visible damage, cracks, or structural issues",
          "\u2610",
          "\u2610",
          "\u2610",
          "{{equip_damage_notes}}"
        ],
        [
          "All guards, shields, and safety devices in place",
          "\u2610",
          "\u2610",
          "\u2610",
          "{{guards_notes}}"
        ],
        [
          "All controls and functions operate correctly",
          "\u2610",
          "\u2610",
          "\u2610",
          "{{controls_notes}}"
        ],
        [
          "No fluid leaks",
          "\u2610",
          "\u2610",
          "\u2610",
          "{{leaks_notes}}"
