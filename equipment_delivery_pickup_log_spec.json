        [
          "Tires / tracks / wheels in good condition",
          "\u2610",
          "\u2610",
          "\u2610",
          "{{wheels_notes}}"
        ],
        [
          "Lights and warning devices functional",
          "\u2610",
          "\u2610",
          "\u2610",
          "{{lights_notes}}"
        ],
        [
          "No loose parts, missing bolts, or unusual wear",
          "\u2610",
          "\u2610",
          "\u2610",
          "{{loose_parts_notes}}"
        ],
        [
          "Operator manual and safety instructions included",
          "\u2610",
          "\u2610",
          "\u2610",
          "{{manual_included}}"
        ],
        [
          "Calibration certificate (if applicable) included and current",
          "\u2610",
          "\u2610",
          "\u2610",
          "{{calibration_notes}}"
        ]
      ],
      "style": "Table Grid"
    },
